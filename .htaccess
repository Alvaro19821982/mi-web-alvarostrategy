###############################################################################
# .htaccess corregido y optimizado – AlvaroStrategy.com
# - Soluciona el problema de 404 en SPAs (React)             (✓ CRÍTICO)
# - Sirve el sitemap con MIME correcto                        (✓ SEO)
# - Mantiene el SPA sin 404 “duros” en rutas internas          (✓ React)
# - Compatible con Apache y LiteSpeed                         (✓ Hosting)
###############################################################################

<IfModule mod_rewrite.c>
  # --- Activar motor de reescritura ---
  RewriteEngine On

  # --- Definir directorio base (importante si el sitio no está en la raíz) ---
  RewriteBase /

  # --- Reglas para el Sitemap (antes de cualquier otra regla de SPA) ---
  # No tocar la petición del sitemap, dejar que se sirva directamente.
  RewriteRule ^sitemap\.xml$ - [L]
  
  # --- Reglas para el SPA (Single Page Application) ---
  # No reescribir la URL si la petición es para el propio index.html
  RewriteRule ^index\.html$ - [L]

  # No reescribir si la petición es para un archivo existente
  RewriteCond %{REQUEST_FILENAME} !-f
  
  # No reescribir si la petición es para un directorio existente
  RewriteCond %{REQUEST_FILENAME} !-d

  # --- REGLA CORREGIDA (CRÍTICA) ---
  # Para cualquier otra petición, sirve el index.html para que React Router tome el control.
  # El "." captura cualquier carácter, haciéndolo más robusto que "^".
  RewriteRule . /index.html [L]
</IfModule>

# --- Forzar MIME type para sitemap (Buena práctica SEO) ---
<Files "sitemap.xml">
  ForceType application/xml
  <IfModule mod_headers.c>
    Header set Content-Type "application/xml; charset=utf-8"
  </IfModule>
</Files>